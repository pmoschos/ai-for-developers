MODEL=gpt-4o-mini
# ── Required ──────────────────────────────────────────────────
SERPER_API_KEY=""             # https://serper.dev (free tier available)

# ── Optional: Push Notifications (Pushover) ───────────────────
PUSHOVER_TOKEN=...              # https://pushover.net
PUSHOVER_USER=...

# ── Optional: Email Delivery (SendGrid) ───────────────────────
SENDGRID_API_KEY=...            # https://sendgrid.com (free tier available)
REPORT_FROM_EMAIL=enter_your_email
REPORT_TO_EMAIL=enter_your_email

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
TAVILY_API_KEY=""

# ── Push Notifications (ntfy.sh — free, no account needed for public topics) ──
# Subscribe at: https://ntfy.sh/jobradar-alerts  (or install ntfy app on phone)
NTFY_TOPIC=jobradar-alerts
NTFY_TOKEN=

# ── Email Delivery (Resend — https://resend.com — free: 3 000 emails/month) ───
RESEND_API_KEY=
REPORT_FROM_EMAIL=onboarding@resend.dev
REPORT_TO_EMAIL=enter_your_email

CREWAI_TRACING_ENABLED=true